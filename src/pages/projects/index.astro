---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import small from "../../data/small-projects.json";
const all = await getCollection("projects");
// The CV library projects live on the library's own page; this page lists the library as one project.
const top = all.filter((p) => p.data.kind === "software").sort((a, b) => a.data.order - b.data.order);
const cvCount = all.filter((p) => p.data.kind === "cv").length;
---
<Base title="Projects" description={`The Computer Vision Project Library (${cvCount} measured projects) plus systems, web and data projects.`}>
  <div class="wrap section">
    <div class="section-head"><span class="eyebrow">Projects</span><h1 class="display">Everything I've built</h1>
      <p class="lede">The computer vision library holds {cvCount} measured projects on its own page. Next to it: an
        order-execution engine, an AI SaaS, a production file-conversion API, an Android app and sports analytics.</p></div>
    <div class="grid">{top.map((p, i) => <ProjectCard p={p} eager={i < 3} level={2} />)}</div>
    <h2 class="small-head">Smaller projects</h2>
    <ul class="small">
      {small.map((s) => (
        <li><a href={s.href} target="_blank" rel="noopener">{s.title} ↗</a><span>{s.summary}</span><span class="mono">{s.stack}</span></li>
      ))}
    </ul>
  </div>
</Base>
<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 18px; margin-top: 28px; }
  .small-head { font: 500 18px var(--sans); margin: 48px 0 12px; }
  .small { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .small li { display: grid; grid-template-columns: minmax(180px, 1fr) 2fr minmax(120px, auto); gap: 6px 18px; padding: 12px 0;
    border-bottom: 1px solid var(--line); font-size: 14.5px; }
  .small a { color: var(--ink); text-decoration-color: var(--signal); }
  .small span { color: var(--ink-2); } .small .mono { font-size: 12px; color: var(--ink-3); }
  @media (max-width: 700px) { .small li { grid-template-columns: 1fr; } }
</style>
