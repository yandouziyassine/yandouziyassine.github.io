---
import Base from "../../layouts/Base.astro";
import Metric from "../../components/Metric.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection, render } from "astro:content";
export async function getStaticPaths() {
  const all = await getCollection("projects");
  return all.map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const d = p.data;
const LIBRARY = "computer-vision-project-library";
// The library page is the hub of the CV projects: their grid sits under its text, and they link back to it.
const cv = p.id === LIBRARY
  ? (await getCollection("projects")).filter((x) => x.data.kind === "cv").sort((a, b) => a.data.order - b.data.order) : [];
const areas = [...new Set(cv.map((x) => x.data.area))].sort();
const back = d.kind === "cv" ? { href: `/projects/${LIBRARY}/`, label: "← Computer Vision Project Library" } : { href: "/projects/", label: "← All projects" };
const { Content } = await render(p);
---
<Base title={d.title} description={d.summary}>
  <article class="wrap section">
    <a class="back mono" href={back.href}>{back.label}</a>
    <header class="head">
      <span class="eyebrow">{d.number ? `Project ${d.number} · ` : ""}{d.area}</span>
      <h1 class="display">{d.title}</h1>
      <p class="lede">{d.summary}</p>
      {d.metric && <Metric value={d.metric.value} unit={d.metric.unit} />}
      <div class="actions">
        {d.links.demo && <a class="btn primary" href={d.links.demo} {...(d.links.demo.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}>▶ Try it live</a>}
        {d.links.code && <a class="btn" href={d.links.code} target="_blank" rel="noopener">Code on GitHub ↗</a>}
      </div>
      {d.stack.length > 0 && <div class="chips">{d.stack.map((s) => <span class="chip">{s}</span>)}</div>}
    </header>
    <div class="prose"><Content /></div>
    {cv.length > 0 && (
      <section class="library" aria-labelledby="cv-projects">
        <h2 id="cv-projects">The {cv.length} projects</h2>
        <div class="filters" role="toolbar" aria-label="Filter by topic">
          <button class="chip" aria-pressed="true" data-f="*">All {cv.length}</button>
          {areas.map((a) => <button class="chip" aria-pressed="false" data-f={a}>{a}</button>)}
        </div>
        <div class="grid">{cv.map((x) => <ProjectCard p={x} />)}</div>
      </section>
    )}
  </article>
</Base>
<script>
  const bar = document.querySelector(".library .filters");
  bar?.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest("button");
    if (!b) return;
    bar.querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    document.querySelectorAll<HTMLElement>(".library .card").forEach((c) => {
      c.hidden = b.dataset.f !== "*" && c.dataset.area !== b.dataset.f;
    });
  });

  // Animated figures are first shown as their first frame (data-anim holds the animation, see scripts/media.mjs):
  // swap the animation in once the page has loaded, or on click when the visitor prefers reduced motion.
  const play = (img: HTMLImageElement) => {
    const anim = img.dataset.anim;
    if (!anim) return;
    delete img.dataset.anim;
    const next = new Image();
    next.onload = () => { img.src = anim; img.classList.remove("paused"); };
    next.src = anim;
  };
  const imgs = [...document.querySelectorAll<HTMLImageElement>(".prose img[data-anim]")];
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
    for (const img of imgs) {
      img.classList.add("paused");
      img.title = "Animation paused (reduced motion): click to play";
      img.addEventListener("click", () => play(img), { once: true });
    }
  } else {
    const start = () => imgs.forEach(play);
    if (document.readyState === "complete") start();
    else addEventListener("load", start, { once: true });
  }
</script>
<style>
  .back { font-size: 13px; color: var(--ink-3); text-decoration: none; } .back:hover { color: var(--signal); }
  .head { display: grid; gap: 16px; margin: 18px 0 30px; padding-bottom: 30px; border-bottom: 1px solid var(--line); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .prose :global(img.paused) { cursor: pointer; }
  .library { margin-top: 40px; padding-top: 30px; border-top: 1px solid var(--line); }
  .library h2 { font: 500 22px var(--sans); margin: 0; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 22px; }
  .filters .chip { cursor: pointer; background: none; }
  .filters .chip[aria-pressed="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 18px; }
</style>
