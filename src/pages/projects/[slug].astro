---
import Base from "../../layouts/Base.astro";
import Metric from "../../components/Metric.astro";
import { getCollection, render } from "astro:content";
export async function getStaticPaths() {
  const all = await getCollection("projects");
  return all.map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const d = p.data;
const { Content } = await render(p);
---
<Base title={d.title} description={d.summary}>
  <article class="wrap section">
    <a class="back mono" href="/projects/">← All projects</a>
    <header class="head">
      <span class="eyebrow">{d.number ? `Project ${d.number} · ` : ""}{d.area}</span>
      <h1 class="display">{d.title}</h1>
      <p class="lede">{d.summary}</p>
      {d.metric && <Metric value={d.metric.value} unit={d.metric.unit} />}
      <div class="actions">
        {d.links.demo && <a class="btn primary" href={d.links.demo} {...(d.links.demo.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}>▶ Try it live</a>}
        {d.links.code && <a class="btn" href={d.links.code} target="_blank" rel="noopener">Code on GitHub ↗</a>}
      </div>
      {d.stack.length > 0 && <div class="chips">{d.stack.map((s) => <span class="chip">{s}</span>)}</div>}
    </header>
    <div class="prose"><Content /></div>
  </article>
</Base>
<script>
  // Animated figures are first shown as their first frame (data-anim holds the animation, see scripts/media.mjs):
  // swap the animation in once the page has loaded, or on click when the visitor prefers reduced motion.
  const play = (img: HTMLImageElement) => {
    const anim = img.dataset.anim;
    if (!anim) return;
    delete img.dataset.anim;
    const next = new Image();
    next.onload = () => { img.src = anim; img.classList.remove("paused"); };
    next.src = anim;
  };
  const imgs = [...document.querySelectorAll<HTMLImageElement>(".prose img[data-anim]")];
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
    for (const img of imgs) {
      img.classList.add("paused");
      img.title = "Animation paused (reduced motion): click to play";
      img.addEventListener("click", () => play(img), { once: true });
    }
  } else {
    const start = () => imgs.forEach(play);
    if (document.readyState === "complete") start();
    else addEventListener("load", start, { once: true });
  }
</script>
<style>
  .back { font-size: 13px; color: var(--ink-3); text-decoration: none; } .back:hover { color: var(--signal); }
  .head { display: grid; gap: 16px; margin: 18px 0 30px; padding-bottom: 30px; border-bottom: 1px solid var(--line); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .prose :global(img.paused) { cursor: pointer; }
</style>
