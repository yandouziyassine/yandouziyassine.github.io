---
import fs from "node:fs";
import Base from "../../layouts/Base.astro";
import FootballReplay from "../../components/FootballReplay.astro";
import ReportSection from "../../components/ReportSection.astro";
import { FOOTBALL_LIVE } from "../../data/flags";
import { CARRIER_M, type MatchMeta } from "../../lib/coach/replay";
import type { ModelsJson } from "../../lib/coach/models";

const match = FOOTBALL_LIVE ? (JSON.parse(fs.readFileSync("public/football/match.json", "utf8")) as MatchMeta) : null;
const models = FOOTBALL_LIVE ? (JSON.parse(fs.readFileSync("public/football/models.json", "utf8")) as ModelsJson) : null;
// The match report is optional: without public/football/report.json (sync:football) the section is not built.
const REPORT_LIVE = FOOTBALL_LIVE && fs.existsSync("public/football/report.json");
const shots = models?.shot_trained_on?.shots ?? "";
const sc = models?.shot_trained_on?.skillcorner_matches ?? "";
const ext = { target: "_blank", rel: "noopener" };
---
<Base title="Football AI coach" description="Replay a full Bundesliga match in 2D or 3D, pause at any moment and see what an AI coach would do with the ball, then what the pro did.">
  <div class="wrap section">
    <a class="back mono" href="/demos/">← All demos</a>
    <div class="section-head"><span class="eyebrow">Live demo · project 20</span><h1 class="display">Pause the match. Ask the coach.</h1>
      <p class="lede">{match ? `${match.meta.home} vs ${match.meta.guest}, 2. Bundesliga 2022/23` : "A full Bundesliga match"},
        replayed from optical tracking of every player and the ball. Pause when a player has the ball: the coach ranks his
        passes, carries and shot in expected goals. Follow it or refuse it, then watch what the professional did. Switch to 3D
        at any moment: stadium camera, tactical view or a player's eyes.</p></div>
    {match && models ? (
      <>
        <div class="panel box"><FootballReplay /></div>
        {REPORT_LIVE && <ReportSection />}
        <h2 class="small">How to read it</h2>
        <ul class="notes">
          <li><b>Arrows</b>: the coach's top three options, the best in orange; once you choose, your option turns green. The % is the chance that the pass arrives
            (pass model), that the team still has the ball after a 6 m carry (pitch control), or that a shot scores.</li>
          <li><b>Value</b>: the expected change in net expected goals (xG) over the next {models.value.horizon_s ?? 15} s if the
            option is chosen, counting the cost of losing the ball where it would be lost.</li>
          <li><b>Tally</b>: the sum of the coach's value for the options you, the coach and the pros chose. It is the coach's
            opinion of every choice, not a result.</li>
          <li><b>Player cards</b>: under the options, a small card for the player with the ball, and for the target of a pass
            while you point at or focus that option. It says how the player's passes compared with what the pass model expected
            in the other matches of the dataset, and how many passes that is. "Slightly more than expected" is a small
            difference; "too few to say" means less than 20 passes or shots. If the player has no history in the other matches
            (the opponent in this replay plays in none), the card says so. The cards are shown for information and
            <b>do not change the advice</b>: see the limits below.</li>
          <li><b>3D view</b> (button or V): the same moment in 3D; C or the camera buttons switch between the stadium
            camera, a tactical view from above and a player's eyes. Tap a player, or pick him in "Whose eyes", to stand
            at his head height (1.7 m) looking where he is running, or at the ball when he stands still. The arrows lie
            on the grass; the full list of options stays below the pitch.</li>
        </ul>
        <h2 class="small">Honest limits</h2>
        <ul class="notes">
          <li>The models were trained on the {models.trained_on.length} other matches of the dataset; this match
            ({models.trained_without}) was never seen in training.</li>
          <li>The pass model is solid (held-out AUC 0.77–0.84). The value model is weak: it explains about 2 % of what happens
            in the next 15 s, barely more than "closer to goal is better", so differences of a few thousandths of a goal mean little.</li>
          <li>The coach plays bolder than the pros: passes it ranks first are completed 66 % of the time, against 84 % for
            its 7th choice and below, and it has the pro's receiver in its top 3 about as often as chance (33 % vs 30 %).
            It recommends a pass as its best option 92 % of the time (84 % before the cut-back fix). It gives a value
            opinion, not a prediction of what a player will do.</li>
          <li>Cut-backs (a pass from the byline back to the centre) used to be ranked in the bottom few percent, although
            they are followed by a goal within 15 s about one time in four. Passes now get their own "arrival" value, and
            on held-out matches completed cut-backs are ranked near the top (median 99th percentile in the A-League, 98th
            in the Bundesliga, from the 4th and 6th). The coach score now agrees with what happens next (Spearman +0.09,
            it was slightly negative), although the value model behind it is still weak. With only 7 Bundesliga cut-backs,
            treat that league's figure as indicative.</li>
          <li>The shot option uses our own small shot model, now trained on {shots} shots from two leagues: the other Bundesliga
            matches and {sc} A-League matches (SkillCorner open data). On held-out Bundesliga matches this lowered its
            log-loss from 0.325 to 0.306 and raised its AUC from 0.63 to 0.68, but that rests on 16 goals; the data
            provider's xG reaches 0.82.</li>
          <li>The player cards are for information only. In a held-out test (profiles and models built without the match
            being scored) they did not improve the pass advice on this league, where only 7 matches are available and
            few players appear in several of them; they gave a small gain on the A-League, with 20 matches; and finishing
            showed no signal in 160 shots. So the coach ignores them (their weight is 0), and with so little history the
            estimates are pulled strongly towards "as expected". They describe past matches, not this one.</li>
          <li>The ball carrier is the nearest player of the team in possession within {CARRIER_M} m of the ball (ball height
            is not used); speeds come from positions 0.16 s apart, as in training. "What the pro did" comes from the official
            events when they could be synchronised with the tracking (about two thirds of the passes), otherwise from the tracking.</li>
          <li>The 3D figures come from the tracking positions only: there is no body pose, so the player's-eyes camera
            follows his movement, not his head. The ball's height comes from the same optical tracking.</li>
          <li>Everything runs in your browser; your choices stay in memory and are gone when you leave.</li>
        </ul>
        <p><a class="case" href="/projects/football-analytics/">How the coach was built and evaluated →</a></p>
        <h2 class="small">Data credit</h2>
        <p class="credit">{match.credit}. Bassek et al. (2025), <i>Scientific Data</i>:{" "}
          <a href="https://doi.org/10.1038/s41597-025-04505-y" {...ext}>paper</a>,{" "}
          <a href="https://doi.org/10.6084/m9.figshare.28196177" {...ext}>data</a>;{" "}
          licence <a href="https://creativecommons.org/licenses/by/4.0/" {...ext}>CC BY 4.0</a>. Changes: positions
          subsampled from 25 to 12.5 frames per second and rounded to the centimetre; events synchronised to the tracking. The
          shot model was also fitted on shots from <a href="https://github.com/SkillCorner/opendata" {...ext}>SkillCorner open data</a>
          (MIT licence), 20 A-League 2024/25 matches; only the fitted weights are used here, none of that data is shown.</p>
      </>
    ) : (
      <p class="panel box soon">Coming soon: the replay match and the coach's model weights are being exported from the project 20 study.</p>
    )}
  </div>
</Base>
<style>
  .back { font-size: 13px; color: var(--ink-3); text-decoration: none; } .back:hover { color: var(--signal); }
  .box { padding: clamp(12px, 3vw, 22px); margin-top: 24px; }
  .soon { color: var(--ink-2); }
  .small { font: 500 15px var(--sans); margin: 28px 0 8px; }
  .notes { max-width: 760px; padding-left: 18px; font-size: 15px; color: var(--ink-2); }
  .notes li { margin-bottom: 6px; }
  .credit { max-width: 760px; font-size: 13px; color: var(--ink-3); }
  .credit a, .case { color: var(--ink); text-decoration-color: var(--signal); }
</style>
