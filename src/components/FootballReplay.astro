---
// Football replay (project 20, phase 2): one full Bundesliga match on a 2D pitch. Pause when a player has the ball and
// the coach (src/lib/coach, a parity-tested port of the library's coach engine) ranks his options; follow or refuse,
// then see what the pro did. Data in /football/ (scripts/football.mjs): match.json, models.json and the first half
// load on the first hover, touch or focus (not on page load), the second half (3.2 / 4.5 MB per half) when first
// needed. Choices stay in memory; nothing is sent anywhere. Phase 3: a 3D view of the same moment (stadium camera,
// tactical view, a player's eyes) from src/lib/football3d/, loaded with import() on the first "3D view" press so
// three.js never weighs on the 2D page; the ball's height (z0/z1.bin, 68 kB per half) loads with it. The visitor steers
// the 3D camera: drag to look around (eyes) or orbit (stadium) or pan (tactical), wheel or pinch to zoom, double tap or 0
// to re-centre, and Q/E R/F when the 3D stage has focus (controls in src/lib/football3d/controls.ts).
---
<div class="fr" data-football>
  <div class="stage">
    <canvas class="pitch" data-canvas role="img" aria-label="Football pitch; the match is loading"></canvas>
    <div class="stage3d" data-stage3d hidden tabindex="0" role="group" aria-label="3D scene" aria-describedby="fr-3d-hint">
      <div class="labels3d" data-labels3d aria-hidden="true"></div>
    </div>
    <p class="hint3d mono" id="fr-3d-hint" data-hint3d hidden></p>
  </div>
  <div class="bar">
    <button type="button" class="btn primary ctl" data-play>Play</button>
    <span class="clock mono" data-clock>00:00</span>
    <div class="group" role="group" aria-label="Playback speed">
      <button type="button" class="btn ctl" data-speed="1" aria-pressed="true">1×</button>
      <button type="button" class="btn ctl" data-speed="2" aria-pressed="false">2×</button>
      <button type="button" class="btn ctl" data-speed="4" aria-pressed="false">4×</button>
    </div>
    <div class="group" role="group" aria-label="Half">
      <button type="button" class="btn ctl" data-half="0" aria-pressed="true" disabled>1st half</button>
      <button type="button" class="btn ctl" data-half="1" aria-pressed="false" disabled>2nd half</button>
    </div>
    <button type="button" class="btn ctl" data-view3d aria-pressed="false" aria-describedby="fr-3d-note" disabled>3D view</button>
  </div>
  <div class="view3d">
    <fieldset class="cams" data-cams hidden>
      <legend class="sr-only">Camera</legend>
      <label class="cam"><input type="radio" name="fr-cam" value="broadcast" checked /> Stadium</label>
      <label class="cam"><input type="radio" name="fr-cam" value="tactical" /> Tactical</label>
      <label class="cam"><input type="radio" name="fr-cam" value="eyes" /> Player's eyes</label>
    </fieldset>
    <label class="jump mono" data-eyes-row hidden>Whose eyes
      <select data-eyes></select>
    </label>
    <button type="button" class="btn ctl" data-recentre hidden>Re-centre view</button>
    <span class="note3d mono" id="fr-3d-note" data-note3d>3D view: stadium camera, tactical view or a player's eyes (tap a player). Loaded only when you ask for it.</span>
  </div>
  <div class="timeline">
    <div class="marks" data-marks aria-hidden="true"></div>
    <label class="sr-only" for="fr-time">Match time</label>
    <input id="fr-time" type="range" min="0" max="0" step="1" value="0" data-time disabled />
  </div>
  <label class="jump mono">Jump to
    <select data-jump disabled><option value="">a goal or a shot…</option></select>
  </label>
  <p class="status mono" data-status role="status" aria-live="polite">The match loads when you hover over, touch or focus this panel (about 3.5 MB for the first half).</p>
  <section class="coach" data-coach hidden aria-labelledby="fr-coach">
    <h2 class="small" id="fr-coach">The coach's options <span data-coach-who></span></h2>
    <ol class="opts" data-options></ol>
    <div class="cards" data-cards role="group" aria-label="Player cards, for information only: they do not change the advice" hidden>
      <div class="card" data-card="carrier"><p class="who" data-card-who></p><ul data-card-lines></ul></div>
      <div class="card target" data-card="target" hidden><p class="who" data-card-who></p><ul data-card-lines></ul></div>
    </div>
    <div class="actions">
      <button type="button" class="btn primary ctl" data-follow>Follow the coach</button>
      <span class="hint mono">or pick another option (keys 1–9) to refuse</span>
    </div>
  </section>
  <p class="reveal" data-reveal role="status" aria-live="polite" hidden></p>
  <table class="tally">
    <caption class="sr-only">Running tally: the coach's expected value of the options chosen</caption>
    <thead><tr><th scope="col">Tally</th><th scope="col">Choices</th><th scope="col">Expected value</th></tr></thead>
    <tbody>
      <tr><th scope="row">You</th><td data-tally-decisions>0</td><td data-tally-viewer>+0.000 xG</td></tr>
      <tr><th scope="row">Coach</th><td data-tally-coach-n>0</td><td data-tally-coach>+0.000 xG</td></tr>
      <tr><th scope="row">Pros</th><td data-tally-pro-n>0</td><td data-tally-pro>+0.000 xG</td></tr>
    </tbody>
  </table>
  <p class="keys mono">You followed the coach <span data-tally-followed>0 of 0</span> times · Keys: Space play / pause · ← → 5 s · F follow · 1–9 pick · V 3D view · C camera · in the 3D view: Q/E R/F look, 0 re-centre</p>
</div>
<script>
  import { options as rankOptions, type Coach, type CoachOption } from "../lib/coach/advice";
  import { decide, emptyTally, outcome, proChoice, reveal, type Outcome, type ProChoice, type Tally } from "../lib/coach/decision";
  import { arrowLabel, frameLabel, optionLabel, outcomeLabel, proLabel, signedXg, textOn } from "../lib/coach/format";
  import { HALF_LENGTH, HALF_WIDTH, normalise, type Vec } from "../lib/coach/geometry";
  import { coachFromModels, type ModelsJson } from "../lib/coach/models";
  import { cardLines, cardText, readProfiles, type ProfilesJson } from "../lib/coach/profiles";
  import { carrierAt, clock, decodeHalf, frameDots, markers, nearestCarrierFrame, playerAt, scoreAt, stateAt, trail, type Carrier, type HalfData, type MatchMeta } from "../lib/coach/replay";
  import { nextCamera, type CameraMode } from "../lib/football3d/camera";
  import { buildFrame, decodeBallZ, eyesChoices, type ArrowSpec, type Tone } from "../lib/football3d/frame";
  import { hasWebGL } from "../lib/football3d/webgl";
  import type { View3D } from "../lib/football3d/view3d"; // type only: three.js is loaded by import() in open3d()

  const BASE = "/football/";
  const MARGIN = 3; // metres drawn around the pitch (the goals stick out 2 m)
  const same = (a: CoachOption, b: CoachOption) => a.kind === b.kind && a.target === b.target && a.angle === b.angle;

  function mount(root: HTMLElement) {
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const canvas = $<HTMLCanvasElement>("[data-canvas]"), ctx = canvas.getContext("2d")!;
    const playBtn = $<HTMLButtonElement>("[data-play]"), followBtn = $<HTMLButtonElement>("[data-follow]");
    const time = $<HTMLInputElement>("[data-time]"), jump = $<HTMLSelectElement>("[data-jump]");
    const status = $("[data-status]"), coachBox = $("[data-coach]"), list = $("[data-options]"), revealBox = $("[data-reveal]");
    const halfBtns = [...root.querySelectorAll<HTMLButtonElement>("[data-half]")];
    const stage3d = $("[data-stage3d]"), labels3d = $("[data-labels3d]"), view3dBtn = $<HTMLButtonElement>("[data-view3d]");
    const cams = $<HTMLFieldSetElement>("[data-cams]"), eyesRow = $("[data-eyes-row]"), eyesSel = $<HTMLSelectElement>("[data-eyes]");
    const note3d = $("[data-note3d]"), hint3d = $("[data-hint3d]"), recentre = $<HTMLButtonElement>("[data-recentre]");
    const cards = $("[data-cards]"), carrierCard = $("[data-card=carrier]"), targetCard = $("[data-card=target]");
    const css = getComputedStyle(document.documentElement);
    const SIGNAL = css.getPropertyValue("--signal").trim() || "#ff5b1f";
    const OK = css.getPropertyValue("--ok").trim() || "#7fd18b";
    const MONO = css.getPropertyValue("--font-mono").trim() || "monospace";
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const TONE: Record<Tone, string> = { best: SIGNAL, pick: OK, other: "rgba(236, 235, 230, 0.85)" };
    const HINTS: Record<CameraMode, string> = {
      eyes: "Drag to look around · Q/E R/F · 0 re-centres",
      broadcast: "Drag to orbit · wheel or pinch to zoom · Q/E R/F · 0 re-centres",
      tactical: "Drag to pan · wheel or pinch to zoom · Q/E R/F · 0 re-centres",
    };
    const CAMERA_NAMES: Record<CameraMode, string> = { broadcast: "stadium camera", tactical: "tactical view", eyes: "player's eyes" };

    let meta = null as unknown as MatchMeta;
    let profiles: ProfilesJson | null = null; // display-only player cards; null = file missing, no cards
    let coach = null as unknown as Coach;
    let ready = false, half = 0, t = 0, playing = false, speed = 1, last = 0, dpr = 1;
    const halves: (HalfData | undefined)[] = [];
    const loads: (Promise<HalfData> | undefined)[] = [];
    let advice: { half: number; frame: number; carrier: Carrier; opts: CoachOption[] } | null = null;
    let chosen: { half: number; frame: number; option: CoachOption } | null = null;
    let pending: { half: number; pro: ProChoice; result: Outcome } | null = null;
    let tally: Tally = emptyTally();
    let view3d: View3D | null = null, opening3d = false, webgl = false, camMode: CameraMode = "broadcast", eyesOf: number | null = null;
    const zHalves: (Int16Array | null | undefined)[] = []; // ball height per half: undefined = not asked yet, null = none

    const say = (text: string) => { status.textContent = text; };
    const failed = (err: unknown) => { say("Could not load the match data. Please reload the page."); console.warn(err); };
    const frameNow = () => Math.floor(t);

    function getHalf(i: number): Promise<HalfData> {
      if (halves[i]) return Promise.resolve(halves[i]!);
      return (loads[i] ??= fetch(`${BASE}h${i}.bin`)
        .then((r) => { if (!r.ok) throw new Error(`h${i}.bin: HTTP ${r.status}`); return r.arrayBuffer(); })
        .then((buf) => (halves[i] = decodeHalf(buf, meta.halves[i], meta.players.length)))
        .catch((e) => { loads[i] = undefined; throw e; }));
    }

    // The ball's height (z<i>.bin, 68 kB per half) is only drawn in 3D: fetched the first time 3D shows that half.
    // Missing file or failed fetch: the 3D ball rests on the grass.
    async function getBallZ(i: number): Promise<Int16Array | null> {
      if (zHalves[i] !== undefined) return zHalves[i]!;
      try {
        const r = await fetch(`${BASE}z${i}.bin`);
        zHalves[i] = r.ok ? decodeBallZ(await r.arrayBuffer(), meta.halves[i].frames) : null;
      } catch (e) {
        console.warn(e);
        zHalves[i] = null;
      }
      return zHalves[i]!;
    }

    // ---------- drawing ----------
    const scale = () => canvas.width / (2 * HALF_LENGTH + 2 * MARGIN);
    const px = (p: Vec): Vec => { const k = scale(); return [(p[0] + HALF_LENGTH + MARGIN) * k, (HALF_WIDTH + MARGIN - p[1]) * k]; };
    const circle = (p: Vec, r: number) => { const [x, y] = px(p); ctx.beginPath(); ctx.arc(x, y, r, 0, 2 * Math.PI); };
    function box(a: Vec, b: Vec) {
      const [x0, y0] = px(a), [x1, y1] = px(b);
      ctx.strokeRect(Math.min(x0, x1), Math.min(y0, y1), Math.abs(x1 - x0), Math.abs(y1 - y0));
    }

    function resize() {
      dpr = Math.min(2, window.devicePixelRatio || 1);
      const w = Math.max(1, canvas.clientWidth);
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round((w * dpr * (2 * HALF_WIDTH + 2 * MARGIN)) / (2 * HALF_LENGTH + 2 * MARGIN));
      draw();
    }

    function drawPitch(k: number) {
      const line = "rgba(236, 235, 230, 0.55)";
      ctx.fillStyle = "#183224"; ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.strokeStyle = line; ctx.lineWidth = Math.max(dpr, 0.12 * k);
      box([-HALF_LENGTH, -HALF_WIDTH], [HALF_LENGTH, HALF_WIDTH]);
      const [mx, top] = px([0, HALF_WIDTH]), [, bottom] = px([0, -HALF_WIDTH]);
      ctx.beginPath(); ctx.moveTo(mx, top); ctx.lineTo(mx, bottom); ctx.stroke();
      circle([0, 0], 9.15 * k); ctx.stroke();
      for (const s of [-1, 1]) {
        box([s * HALF_LENGTH, -20.16], [s * (HALF_LENGTH - 16.5), 20.16]);
        box([s * HALF_LENGTH, -9.16], [s * (HALF_LENGTH - 5.5), 9.16]);
        box([s * HALF_LENGTH, -3.66], [s * (HALF_LENGTH + 2), 3.66]);
        circle([s * (HALF_LENGTH - 11), 0], Math.max(1.5 * dpr, 0.2 * k)); ctx.fillStyle = line; ctx.fill();
      }
    }

    function arrow(from: Vec, to: Vec, colour: string, label: string, k: number) {
      const [x0, y0] = px(from), [x1, y1] = px(to);
      const a = Math.atan2(y1 - y0, x1 - x0), head = Math.max(9 * dpr, 1.3 * k);
      ctx.strokeStyle = colour; ctx.fillStyle = colour; ctx.lineWidth = Math.max(2 * dpr, 0.3 * k);
      ctx.beginPath(); ctx.moveTo(x0, y0); ctx.lineTo(x1 - 0.7 * head * Math.cos(a), y1 - 0.7 * head * Math.sin(a)); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(x1, y1);
      ctx.lineTo(x1 - head * Math.cos(a - 0.45), y1 - head * Math.sin(a - 0.45));
      ctx.lineTo(x1 - head * Math.cos(a + 0.45), y1 - head * Math.sin(a + 0.45));
      ctx.closePath(); ctx.fill();
      const size = Math.round(Math.max(11 * dpr, 1.25 * k));
      ctx.font = `500 ${size}px ${MONO}`; ctx.textAlign = "left"; ctx.textBaseline = "middle";
      const w = ctx.measureText(label).width + 10, hgt = size + 8;
      const lx = Math.min(canvas.width - w - 2, Math.max(2, x1 + 8)), ly = Math.min(canvas.height - hgt - 2, Math.max(2, y1 - hgt - 6));
      ctx.fillStyle = "rgba(13, 14, 16, 0.85)"; ctx.fillRect(lx, ly, w, hgt);
      ctx.fillStyle = colour; ctx.fillText(label, lx + 5, ly + hgt / 2);
    }

    const shownAdvice = () => (!playing && advice && advice.half === half && advice.frame === frameNow() ? advice : null);

    /** The coach's arrows at this moment (top 3 + the viewer's pick), for the 2D canvas and the 3D view alike. */
    function arrowsNow(h: HalfData): ArrowSpec[] {
      const shown = shownAdvice();
      if (!shown) return [];
      const from = playerAt(h, shown.frame, shown.carrier.player), dir = meta.halves[half].attack[shown.carrier.team];
      if (!from) return [];
      const pick = chosen && chosen.half === half && chosen.frame === shown.frame ? shown.opts.find((o) => same(o, chosen!.option)) ?? null : null;
      const drawn = shown.opts.slice(0, 3);
      if (pick && !drawn.includes(pick)) drawn.push(pick);
      return drawn.map((o): ArrowSpec => ({
        from, to: normalise(o.to, dir), label: arrowLabel(o, meta.players),
        tone: o === pick ? "pick" : o === shown.opts[0] ? "best" : "other",
      }));
    }

    function draw3d() {
      const h = halves[half];
      if (!ready || !h || !view3d) return;
      view3d.show(buildFrame(meta, h, {
        t, z: zHalves[half] ?? null, carrier: shownAdvice()?.carrier.player ?? null, arrows: arrowsNow(h),
        focus: camMode === "eyes" ? eyesOf : null, trail: !reduced,
      }));
    }

    function draw() {
      if (view3d) { draw3d(); return; } // same clock, same frame: only the target differs
      const k = scale();
      drawPitch(k);
      const h = halves[half];
      if (!ready || !h) return;
      if (!reduced) {
        const tr = trail(h, t, meta.fps);
        ctx.strokeStyle = "rgba(255, 255, 255, 0.35)"; ctx.lineWidth = Math.max(dpr, 0.2 * k);
        ctx.beginPath();
        tr.forEach((p, i) => { const [x, y] = px(p); if (i) ctx.lineTo(x, y); else ctx.moveTo(x, y); });
        ctx.stroke();
      }
      const shown = shownAdvice();
      for (const a of arrowsNow(h).reverse()) arrow(a.from, a.to, TONE[a.tone], a.label, k); // best drawn last, on top
      const { players, ball } = frameDots(h, t);
      const r = Math.max(7 * dpr, 1.1 * k);
      ctx.textAlign = "center"; ctx.textBaseline = "middle"; ctx.font = `600 ${Math.round(r * 1.05)}px ${MONO}`;
      for (const d of players) {
        const info = meta.players[d.player];
        const fill = info.team === 0 || info.team === 1 ? meta.meta.colors[info.team] : "#777777", ink = textOn(fill);
        circle(d.at, r); ctx.fillStyle = fill; ctx.fill(); ctx.lineWidth = 1.5 * dpr; ctx.strokeStyle = ink; ctx.stroke();
        if (shown && d.player === shown.carrier.player) { circle(d.at, r + 4 * dpr); ctx.lineWidth = 2.5 * dpr; ctx.strokeStyle = SIGNAL; ctx.stroke(); }
        const [x, y] = px(d.at); ctx.fillStyle = ink; ctx.fillText(String(info.shirt), x, y + 0.5);
      }
      if (ball) { circle(ball, Math.max(4 * dpr, 0.55 * k)); ctx.fillStyle = "#ffffff"; ctx.fill(); ctx.lineWidth = 1.5 * dpr; ctx.strokeStyle = "#0d0e10"; ctx.stroke(); }
    }

    // ---------- coach ----------
    function showClock() {
      const c = clock(half, frameNow(), meta.fps);
      $("[data-clock]").textContent = c;
      time.setAttribute("aria-valuetext", `${c}, ${half ? "second" : "first"} half`);
    }

    function cameraName(): string {
      return camMode === "eyes" && eyesOf !== null ? `the eyes of #${meta.players[eyesOf].shirt} ${meta.players[eyesOf].name}` : CAMERA_NAMES[camMode];
    }

    function describe(c: Carrier | null) {
      const f = frameNow(), when = `${clock(half, f, meta.fps)}, ${half ? "second" : "first"} half`, score = scoreAt(meta, half, f);
      canvas.setAttribute("aria-label", frameLabel(meta, "Pitch", when, score, c));
      view3d?.canvas.setAttribute("aria-label", frameLabel(meta, `3D view (${cameraName()})`, when, score, c));
    }

    // ---------- player cards (display-only: profiles never change the advice) ----------
    const cardTitle = (player: number, role: string) => { const p = meta.players[player]; return `#${p.shirt} ${p.name}, ${role}`; };
    const cardOf = (player: number) => profiles?.players[String(player)];
    function fillCard(card: HTMLElement, player: number, role: string) {
      card.querySelector("[data-card-who]")!.textContent = cardTitle(player, role);
      card.querySelector("[data-card-lines]")!.replaceChildren(...cardLines(cardOf(player)).map((l) => { const li = document.createElement("li"); li.textContent = l; return li; }));
    }
    const hideTargetCard = () => { targetCard.hidden = true; };

    // `shift`: frames the pause was moved to reach a moment with a ball carrier (negative = earlier).
    function updateCoach(shift = 0) {
      const h = halves[half]!, f = frameNow();
      list.replaceChildren();
      advice = null; hideTargetCard();
      const c = carrierAt(meta, half, h, f);
      describe(c);
      if (!c) {
        coachBox.hidden = true; root.dataset.options = "0"; cards.hidden = true;
        say("Paused. Nobody has the ball at this moment: step on a little (→) and the coach will look again.");
        draw(); return;
      }
      const s = stateAt(meta, half, h, f, c.team);
      const opts = rankOptions(s, s.attIdx.indexOf(c.player), coach);
      advice = { half, frame: f, carrier: c, opts };
      const done = !!chosen && chosen.half === half && chosen.frame === f;
      opts.forEach((o, i) => {
        const b = document.createElement("button");
        b.type = "button"; b.className = "opt"; b.textContent = optionLabel(o, meta.players); b.disabled = done;
        b.classList.toggle("best", i === 0);
        b.classList.toggle("chosen", done && same(o, chosen!.option));
        b.addEventListener("click", () => choose(i));
        const li = document.createElement("li"); li.append(b); list.append(li);
        if (profiles && o.kind === "pass" && o.target != null && meta.players[o.target]) {
          // The target's card shows while the pointer is over the option or the option has the focus; a screen reader
          // reads the same text as the button's description.
          const target = o.target;
          const role = "pass target", desc = document.createElement("span");
          desc.className = "sr-only"; desc.id = `fr-card-${i}`; desc.textContent = cardText(cardTitle(target, role), cardOf(target));
          li.append(desc); b.setAttribute("aria-describedby", desc.id);
          const show = () => { fillCard(targetCard, target, role); targetCard.hidden = false; };
          li.addEventListener("pointerenter", show); li.addEventListener("pointerleave", hideTargetCard);
          li.addEventListener("focusin", show);
          li.addEventListener("focusout", (e) => { if (!li.contains(e.relatedTarget as Node | null)) hideTargetCard(); });
        }
      });
      if (profiles) { fillCard(carrierCard, c.player, "ball carrier"); cards.hidden = false; }
      const p = meta.players[c.player];
      $("[data-coach-who]").textContent = `for #${p.shirt} ${p.name}`;
      followBtn.disabled = done; coachBox.hidden = false; root.dataset.options = String(opts.length);
      const moved = shift ? `Paused ${(Math.abs(shift) / meta.fps).toFixed(1)} s ${shift < 0 ? "earlier" : "later"}, when` : "Paused.";
      say(done ? "You already chose here. Press Play to see what the pro did."
        : `${moved} #${p.shirt} ${p.name} ${shift ? "had" : "has"} the ball: ${opts.length} options, best first. Follow the coach or pick another (1–9).`);
      draw();
    }

    function renderTally() {
      const set = (key: string, v: string) => { $(`[data-tally-${key}]`).textContent = v; };
      set("decisions", String(tally.decisions)); set("viewer", signedXg(tally.viewer));
      set("coach-n", String(tally.decisions)); set("coach", signedXg(tally.coach));
      set("pro-n", String(tally.proCounted)); set("pro", signedXg(tally.pro));
      set("followed", `${tally.followed} of ${tally.decisions}`);
    }

    function doReveal() {
      if (!pending) return;
      const p = pending;
      pending = null;
      tally = reveal(tally, p.pro);
      revealBox.textContent = `${proLabel(p.pro, meta.players)} Outcome within 15 s: ${outcomeLabel(p.result)}.`;
      revealBox.hidden = false;
      renderTally();
    }

    function choose(i: number) {
      if (playing || !advice) return;
      const { opts, carrier, frame } = advice, option = opts[i];
      if (!option || (chosen && chosen.half === half && chosen.frame === frame)) return;
      doReveal(); // an earlier choice that was never revealed
      tally = decide(tally, opts, option);
      chosen = { half, frame, option };
      pending = { half, pro: proChoice(meta, half, halves[half]!, frame, carrier, opts), result: outcome(meta, half, frame, carrier.team) };
      revealBox.hidden = true;
      renderTally(); updateCoach();
      say(`${i === 0 ? "You followed the coach" : "You refused the coach"}: ${optionLabel(option, meta.players)}. Press Play to see what the pro did.`);
    }

    // ---------- playback ----------
    function seek(frame: number) {
      doReveal(); // moving away from a choice reveals it at once
      t = Math.max(0, Math.min(meta.halves[half].frames - 1, Math.round(frame)));
      time.value = String(t); showClock();
      if (!playing) updateCoach(); else draw();
    }

    function tick(now: number) {
      if (!playing) return;
      const end = meta.halves[half].frames - 1;
      t += (Math.min(100, now - last) / 1000) * meta.fps * speed;
      last = now;
      if (half === 0 && t > end - 60 * meta.fps) getHalf(1).catch(() => {}); // prefetch the second half
      if (pending && pending.half === half && t >= pending.pro.revealFrame) doReveal();
      if (t >= end) {
        t = end; pause();
        if (half === 1) say("Full time.");
        else { say("Half time."); if (!reduced) setHalf(1, 0).then(play).catch(failed); }
        return;
      }
      time.value = String(frameNow()); showClock(); draw();
      requestAnimationFrame(tick);
    }

    function play() {
      if (playing || !ready || frameNow() >= meta.halves[half].frames - 1) return;
      playing = true; playBtn.textContent = "Pause"; coachBox.hidden = true; advice = null; root.dataset.options = "0"; cards.hidden = true; say("");
      last = performance.now(); requestAnimationFrame(tick);
    }

    function pause() {
      if (!playing) return;
      playing = false; playBtn.textContent = "Play";
      t = frameNow();
      // The ball is usually between two players at a random instant: move to the nearest moment someone has it.
      const from = t, snap = carrierAt(meta, half, halves[half]!, t) ? null : nearestCarrierFrame(meta, half, halves[half]!, t);
      if (snap !== null) t = snap;
      time.value = String(t); showClock(); updateCoach(t - from);
    }

    const toggle = () => (playing ? pause() : play());

    async function setHalf(i: number, frame: number) {
      pause();
      if (!halves[i]) { say(`Loading the ${i ? "second" : "first"} half…`); playBtn.disabled = true; }
      await getHalf(i);
      if (view3d) await getBallZ(i);
      playBtn.disabled = false;
      half = i; time.max = String(meta.halves[i].frames - 1);
      halfBtns.forEach((b) => b.setAttribute("aria-pressed", String(Number(b.dataset.half) === i)));
      const marks = $("[data-marks]"), n = meta.halves[i].frames - 1;
      marks.replaceChildren(...markers(meta).filter((m) => m.half === i).map((m) => {
        const s = document.createElement("span");
        s.className = `mark ${m.kind}`; s.style.left = `${(100 * m.frame) / n}%`;
        return s;
      }));
      if (view3d) fillEyes();
      seek(frame);
    }

    async function init() {
      const get = (f: string) => fetch(BASE + f).then((r) => { if (!r.ok) throw new Error(`${f}: HTTP ${r.status}`); return r.json(); });
      // The cards are optional: a missing or unreadable profiles.json only means no cards.
      const [m, w, prof] = await Promise.all([get("match.json"), get("models.json"), get("profiles.json").catch(() => null)]);
      meta = m as MatchMeta; coach = coachFromModels(w as ModelsJson); profiles = readProfiles(prof);
      say("Loading the first half…");
      await getHalf(0);
      ready = true;
      for (const mk of markers(meta)) jump.add(new Option(mk.label, `${mk.half}:${mk.frame}`));
      playBtn.disabled = false; time.disabled = false; jump.disabled = false;
      halfBtns.forEach((b) => (b.disabled = false));
      webgl = hasWebGL();
      root.dataset.webgl = String(webgl);
      view3dBtn.disabled = !webgl;
      if (!webgl) note3d.textContent = "The 3D view needs WebGL 2, which this browser does not offer; the 2D pitch shows everything.";
      await setHalf(0, 0);
      root.dataset.ready = "true";
      say(`Ready: ${meta.meta.home} vs ${meta.meta.guest}. Press Play (or Space) and pause whenever a player has the ball.`);
    }

    // ---------- 3D view ----------
    function fillEyes() {
      const list = eyesChoices(meta, halves[half]!);
      eyesSel.replaceChildren(...list.map((c) => new Option(c.label, String(c.player))));
      if (!list.some((c) => c.player === eyesOf)) eyesOf = null;
      if (eyesOf !== null) eyesSel.value = String(eyesOf);
    }

    function setCamera(mode: CameraMode) {
      camMode = mode;
      if (mode === "eyes" && eyesOf === null) eyesOf = shownAdvice()?.carrier.player ?? (eyesSel.value ? Number(eyesSel.value) : null);
      if (eyesOf !== null) eyesSel.value = String(eyesOf);
      cams.querySelectorAll<HTMLInputElement>("input").forEach((r) => (r.checked = r.value === mode));
      eyesRow.hidden = mode !== "eyes";
      hint3d.textContent = HINTS[mode];
      root.dataset.camera = mode;
      view3d?.setMode(mode);
      describe(carrierAt(meta, half, halves[half]!, frameNow()));
      say(`3D view: ${cameraName()}. C changes the camera, V goes back to 2D.`);
      draw();
    }

    async function open3d() {
      if (view3d || opening3d || !ready || !webgl) return;
      opening3d = true;
      view3dBtn.disabled = true;
      say("Loading the 3D view…");
      try {
        const [{ createView3D }] = await Promise.all([import("../lib/football3d/view3d"), getBallZ(half)]);
        view3d = createView3D({
          host: stage3d, labels: labels3d, reduced,
          onRender: (calls) => { root.dataset.drawCalls = String(calls); },
          onCamera: (r) => { for (const [k, v] of Object.entries(r)) stage3d.setAttribute(`data-camera-${k}`, String(v)); }, // read-only, for tests
          onTap: (x, y) => { // a click or tap that was not a drag: see through that player's eyes
            const p = view3d?.pickAt(x, y);
            if (p == null) return;
            eyesOf = p;
            setCamera("eyes");
          },
          onLost: () => { close3d(); say("The 3D view stopped (the browser dropped its graphics context). Press 3D view to try again."); },
        });
      } catch (err) {
        console.warn(err);
        say("The 3D view could not start in this browser; the 2D pitch shows everything.");
        return;
      } finally {
        opening3d = false;
        view3dBtn.disabled = false;
      }
      stage3d.hidden = false; canvas.hidden = true; cams.hidden = false; hint3d.hidden = false; recentre.hidden = false;
      view3dBtn.setAttribute("aria-pressed", "true");
      root.dataset.view = "3d";
      fillEyes();
      setCamera(camMode);
    }

    function close3d() {
      if (!view3d) return;
      view3d.dispose(); // frees the GPU memory and removes the 3D canvas
      view3d = null;
      stage3d.hidden = true; canvas.hidden = false; cams.hidden = true; eyesRow.hidden = true; hint3d.hidden = true; recentre.hidden = true;
      for (const a of stage3d.getAttributeNames()) if (a.startsWith("data-camera-")) stage3d.removeAttribute(a);
      view3dBtn.setAttribute("aria-pressed", "false");
      root.dataset.view = "2d";
      delete root.dataset.drawCalls;
      say("Back to the 2D pitch.");
      resize();
    }

    function flip3d() {
      if (view3d) close3d();
      else open3d().catch(failed);
    }

    // ---------- wiring ----------
    playBtn.addEventListener("click", () => (ready ? toggle() : start()));
    followBtn.addEventListener("click", () => choose(0));
    time.addEventListener("input", () => seek(Number(time.value)));
    jump.addEventListener("change", () => {
      if (!jump.value) return;
      const [hh, f] = jump.value.split(":").map(Number);
      jump.value = "";
      // The shot frame itself has the ball in flight: land on the last moment the shooter (or a team-mate) had it.
      getHalf(hh).then((h) => setHalf(hh, nearestCarrierFrame(meta, hh, h, f, 4, 0) ?? f)).catch(failed);
    });
    root.querySelectorAll<HTMLButtonElement>("[data-speed]").forEach((b) => b.addEventListener("click", () => {
      speed = Number(b.dataset.speed);
      root.querySelectorAll("[data-speed]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    }));
    halfBtns.forEach((b) => b.addEventListener("click", () => { if (ready) setHalf(Number(b.dataset.half), 0).catch(failed); }));
    view3dBtn.addEventListener("click", flip3d);
    cams.addEventListener("change", (e) => setCamera((e.target as HTMLInputElement).value as CameraMode));
    eyesSel.addEventListener("change", () => { eyesOf = Number(eyesSel.value); setCamera("eyes"); });
    recentre.addEventListener("click", () => { view3d?.reset(); stage3d.focus({ preventScroll: true }); });
    stage3d.addEventListener("keydown", (e) => { // only with focus on the 3D stage, so F (follow) and the digits keep their meaning elsewhere
      if (e.altKey || e.ctrlKey || e.metaKey || e.target !== stage3d || !view3d?.key(e.key)) return;
      e.preventDefault();
      e.stopPropagation(); // the global shortcuts below do not see it
    });
    window.addEventListener("keydown", (e) => {
      if (!ready || e.altKey || e.ctrlKey || e.metaKey) return;
      const el = e.target as HTMLElement | null, tag = el?.tagName ?? "";
      const radio = tag === "INPUT" && (el as HTMLInputElement).type === "radio"; // the camera radios do not use V or C
      if (/^[vVcC]$/.test(e.key) && (radio || (tag !== "INPUT" && tag !== "SELECT" && tag !== "TEXTAREA"))) {
        e.preventDefault();
        if (e.key === "v" || e.key === "V") { if (webgl) flip3d(); }
        else if (view3d) setCamera(nextCamera(camMode));
        return;
      }
      if (tag === "INPUT" || tag === "SELECT" || tag === "TEXTAREA") return; // the control handles its own keys
      if (e.key === " " && tag !== "BUTTON") { e.preventDefault(); toggle(); }
      else if (e.key === "ArrowLeft" || e.key === "ArrowRight") { e.preventDefault(); seek(frameNow() + (e.key === "ArrowLeft" ? -1 : 1) * Math.round(5 * meta.fps)); }
      else if (e.key === "f" || e.key === "F") choose(0);
      else if (/^[1-9]$/.test(e.key)) choose(Number(e.key) - 1);
    });
    new ResizeObserver(resize).observe(canvas);
    // The data (about 3.5 MB for the first half) loads on the first hover, touch or keyboard focus, not on page load:
    // visitors who only read the page download nothing, and the page's Lighthouse performance stays above 0.9.
    let started = false;
    const start = () => { if (!started) { started = true; init().catch(failed); } };
    root.addEventListener("pointerenter", start, { once: true });
    root.addEventListener("focusin", start, { once: true });
  }

  const el = document.querySelector<HTMLElement>("[data-football]");
  if (el) mount(el);
</script>
<style>
  .fr { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; }
  .pitch { display: block; width: 100%; height: auto; aspect-ratio: 111 / 74; background: #183224; border: 1px solid var(--line); border-radius: var(--radius); }
  .bar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .group { display: inline-flex; gap: 6px; }
  .ctl { min-height: 44px; min-width: 44px; justify-content: center; }
  .ctl:not(.primary) { background: transparent; color: var(--ink); }
  .ctl[aria-pressed="true"] { background: var(--signal); color: #0d0e10; }
  .ctl:disabled { opacity: 0.5; cursor: not-allowed; }
  .clock { font-size: 18px; min-width: 64px; }
  .timeline { position: relative; padding-top: 12px; }
  .timeline input { width: 100%; min-height: 44px; margin: 0; accent-color: var(--signal); }
  .marks { position: absolute; left: 0; right: 0; top: 0; height: 12px; pointer-events: none; }
  .marks :global(.mark) { position: absolute; top: 2px; width: 3px; height: 10px; margin-left: -1px; background: var(--ink-3); }
  .marks :global(.mark.goal) { top: 0; width: 5px; height: 12px; margin-left: -2px; background: var(--signal); }
  .jump { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 13px; color: var(--ink-2); }
  .jump select { min-height: 44px; max-width: 100%; padding: 0 10px; font: inherit; color: var(--ink); background: var(--bg-2); border: 1px solid var(--line-2); border-radius: var(--radius); }
  .status, .keys { margin: 0; font-size: 13px; color: var(--ink-2); }
  .small { font: 500 15px var(--sans); margin: 0 0 8px; }
  .opts { margin: 0; padding-left: 26px; display: grid; gap: 6px; color: var(--ink-3); }
  .opts :global(.opt) { width: 100%; min-height: 44px; padding: 8px 12px; text-align: left; font: 14px var(--sans); color: var(--ink);
    background: var(--bg-2); border: 1px solid var(--line-2); border-radius: var(--radius); cursor: pointer; }
  .opts :global(.opt.best) { border-color: var(--signal); }
  .opts :global(.opt.chosen) { border-color: var(--ok); }
  .opts :global(.opt:hover:not(:disabled)) { border-color: var(--signal); }
  .opts :global(.opt:disabled) { cursor: default; color: var(--ink-2); }
  .cards { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px; }
  .card { flex: 1 1 260px; max-width: 420px; padding: 8px 12px; font-size: 13px; color: var(--ink-2); border: 1px solid var(--line); border-radius: var(--radius); }
  .card.target { border-color: var(--signal); }
  .card .who { margin: 0 0 4px; font: 500 13px var(--sans); color: var(--ink); }
  .card ul { margin: 0; padding-left: 16px; }
  .card[hidden], .cards[hidden] { display: none; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 10px; }
  .hint { font-size: 12px; color: var(--ink-3); }
  .reveal { margin: 0; padding: 12px 14px; color: var(--ink-2); border: 1px solid var(--line); border-radius: var(--radius); }
  .tally { width: 100%; max-width: 480px; border-collapse: collapse; font-size: 14px; }
  .tally th, .tally td { padding: 7px 10px; text-align: left; border-bottom: 1px solid var(--line); }
  .stage { position: relative; }
  .stage3d { position: relative; width: 100%; aspect-ratio: 111 / 74; overflow: hidden; background: #0d0e10;
    border: 1px solid var(--line); border-radius: var(--radius); cursor: grab; touch-action: none; }
  .stage3d:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }
  .stage3d :global(canvas) { display: block; width: 100%; height: 100%; touch-action: none; }
  .hint3d { margin: 6px 0 0; font-size: 12px; color: var(--ink-3); }
  .hint3d[hidden] { display: none; }
  .labels3d { position: absolute; inset: 0; pointer-events: none; }
  .labels3d :global(span) { position: absolute; left: 0; top: 0; padding: 2px 6px; font: 500 12px var(--font-mono, monospace);
    color: var(--ink); background: rgba(13, 14, 16, 0.85); border-radius: 4px; white-space: nowrap; }
  .labels3d :global(span.best) { color: var(--signal); }
  .labels3d :global(span.pick) { color: var(--ok); }
  .view3d { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .cams { display: inline-flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; border: 0; }
  .cam { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 12px; font-size: 14px;
    border: 1px solid var(--line-2); border-radius: var(--radius); cursor: pointer; }
  .cam:has(input:checked) { border-color: var(--signal); }
  .cam input { accent-color: var(--signal); }
  .note3d { font-size: 12px; color: var(--ink-3); }
</style>
